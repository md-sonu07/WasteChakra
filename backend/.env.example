# WasteChakra Backend Environment Variables
# Copy to .env. Never commit real secrets.

# Django secret key (REQUIRED in production — generate a new one)
SECRET_KEY=change-me-in-production

# Debug (set False in production)
DEBUG=True

# Comma-separated allowed hosts
ALLOWED_HOSTS=*

# Database. Leave unset to use local SQLite (dev.sqlite3).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Cloudinary media storage (optional — when set AND DEBUG=False)
# CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret